# Clave secreta para firmar cookies y sesiones de Better Auth (minimo 32 caracteres)
# Genera una nueva con: openssl rand -hex 32
BETTER_AUTH_SECRET="cambia-esta-clave-por-una-de-al-menos-32-caracteres-aleatorios"

# URL publica de la app (en produccion usar https://tu-dominio.com)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base de datos SQLite local (o URL libsql:// de Turso en produccion)
DATABASE_URL="file:./data/puntuando.db"
# DATABASE_AUTH_TOKEN=""

# Opcional: si lo definis, nadie puede registrarse sin este codigo compartido
# INVITE_CODE="fer-y-juli"

# Opcional: credenciales iniciales solo para el script npm run db:seed
SEED_FER_EMAIL="fer@puntuando.local"
SEED_FER_PASSWORD="cambia-esta-clave-fer"
SEED_JULI_EMAIL="juli@puntuando.local"
SEED_JULI_PASSWORD="cambia-esta-clave-juli"
